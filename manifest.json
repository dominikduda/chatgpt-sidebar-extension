{
  "manifest_version": 3,
  "name": "Simple ChatGPT Sidebar",
  "version": "1.3.0",
  "description": "Quick access to ChatGPT in a sidebar. Select text and ask ChatGPT about it, or reference entire pages with customizable prompts.",
  
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "clipboardWrite"
  ],
  
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.openai.com/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  
  "options_page": "options.html",
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt-inject.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  
  "action": {
    "default_title": "Open ChatGPT Sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Toggle ChatGPT Sidebar"
    }
  },
  
  "web_accessible_resources": [
    {
      "resources": ["chatgpt-inject.js", "prompt-input.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
